# 2026-09-05 00:56:34.139998
+Create integration test in tests/integration-sc06-boq-waste.test.mjs to integrate SC-06 with real project data:
+
+```javascript
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { referenceProject } from './fixtures/referenceProjectAcceptance.mjs';
+import { calculateBoqWasteLedger } from '../src/utils/scopeReconciliation.ts';
+
+test('SC-06 Integration: Reconcile reference project BOQ items with procurement GRNs and certified WIRs', () => {
+  // Extract real BOQ items from reference project
+  const boqItems = referenceProject.commercial.mainContract.boq;
+  assert.ok(boqItems.length > 0, 'Project must contain BOQ items');
+
+  const firstBoq = boqItems[0];
+
+  // Calculate actual delivered materials from GRNs for this BOQ item
+  const grnRecords = referenceProject.procurement?.grn || [];
+  const purchasedQty = grnRecords
+    .filter(grn => grn.boqItemId === firstBoq.id && grn.status === 'Accepted')
+    .reduce((sum, grn) => sum + grn.quantity, 0) || (firstBoq.plannedQuantity * 1.05); // Fallback to realistic 5% surplus delivery
+
+  // Calculate certified installed quantity from approved WIRs
+  const wirRecords = referenceProject.fieldExecution?.wir || [];
+  const certifiedInstalledQty = wirRecords
+    .filter(wir => wir.boqItemId === firstBoq.id && wir.status === 'Approved')
+    .reduce((sum, wir) => sum + (wir.certifiedQuantity || wir.quantity), 0) || firstBoq.plannedQuantity;
+
+  // Run the SC-06 engine using reference project data
+  const result = calculateBoqWasteLedger({
+    boqItemId: firstBoq.id,
+    contractualWasteAllowancePercent: 8.0, // 8% contract allowance
+    purchasedQty,
+    certifiedInstalledQty,
+    unitRate: firstBoq.rate,
+  });
+
+  // Assertions against project contract facts
+  assert.equal(result.boqItemId, firstBoq.id);
+  assert.equal(result.purchasedQty, purchasedQty);
+  assert.equal(result.certifiedInstalledQty, certifiedInstalledQty);
+  assert.equal(result.wasteQty, purchasedQty - certifiedInstalledQty);
+  assert.ok(result.wastePercentage >= 0, 'Waste percentage must be non-negative');
+  assert.equal(typeof result.isExcessiveWaste, 'boolean');
+});

